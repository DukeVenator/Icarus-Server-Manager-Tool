<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="IcarusServerManager.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ManagerUpdater\ManagerUpdater.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Manager releases are tagged manager-vX.Y.Z; MinVer derives the version from that tag. -->
    <MinVerTagPrefix>manager-v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="steamcmd\steamcmd.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyUpdaterToOutput" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_UpdaterBinDir Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)\..\ManagerUpdater\bin\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)</_UpdaterBinDir>
      <_UpdaterBinDir Condition="'$(RuntimeIdentifier)' == ''">$(MSBuildProjectDirectory)\..\ManagerUpdater\bin\$(Configuration)\net8.0-windows</_UpdaterBinDir>
    </PropertyGroup>
    <ItemGroup>
      <_UpdaterOutputs Include="$(_UpdaterBinDir)\ManagerUpdater.exe" />
      <_UpdaterOutputs Include="$(_UpdaterBinDir)\ManagerUpdater.dll" />
      <_UpdaterOutputs Include="$(_UpdaterBinDir)\ManagerUpdater.deps.json" />
      <_UpdaterOutputs Include="$(_UpdaterBinDir)\ManagerUpdater.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_UpdaterOutputs)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
    <Copy SourceFiles="@(_UpdaterOutputs)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and Exists('%(Identity)')" />
  </Target>

</Project>